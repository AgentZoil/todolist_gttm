generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id          String @id @default(uuid())
  name        String @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users User[]

  @@map("roles")
}

model Department {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users            User[]
  ownedTasks       Task[]                @relation("TaskOwner")
  coordinatingTasks TaskCoordinatingDepartment[]

  @@map("departments")
}

model User {
  id             String   @id @default(uuid())
  authUserId     String   @unique @map("auth_user_id")
  fullName       String   @map("full_name")
  roleId         String   @map("role_id")
  departmentId   String?  @map("department_id")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  role       Role       @relation(fields: [roleId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])

  createdTasks Task[]          @relation("TaskCreator")
  updatedTasks Task[]          @relation("TaskUpdater")
  auditLogs    AuditLog[]
  taskFeedbacks TaskFeedback[]
  taskFeedbackReads TaskFeedbackRead[]

  @@map("users")
}

enum TaskPriority {
  URGENT
  NORMAL
}

enum TaskApprovalStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  NEEDS_REVISION
}

enum TaskOfficialStatus {
  CANCELLED
  IN_PROGRESS
  INCOMPLETE
  COMPLETED_EARLY
  COMPLETED_ON_TIME
  COMPLETED_LATE
  NO_EVALUATION
}

enum TaskFeedbackType {
  DIRECTIVE
  REVIEW
}

enum TaskFeedbackDecision {
  APPROVED
  NEEDS_REVISION
}

model Task {
  id                       String   @id @default(uuid())
  taskCode                 String   @unique @map("task_code")
  title                    String
  content                  String
  source                   String   @map("source")
  assignedDate             DateTime @map("assigned_date")
  assignedBy               String   @map("assigned_by")
  priority                 TaskPriority @default(NORMAL)
  documentNumber           String?  @map("document_number")
  coordinatingUnits        String?  @map("coordinating_units")
  ownerDepartmentId        String   @map("owner_department_id")
  requiredCompletionDate   DateTime? @map("required_completion_date")
  actualCompletionDate     DateTime? @map("actual_completion_date")
  completionEvidence       String?  @map("completion_evidence")
  incompleteReason         String?  @map("incomplete_reason")
  isCancelled              Boolean  @default(false) @map("is_cancelled")
  cancelledAt              DateTime? @map("cancelled_at")
  cancelledBy              String?  @map("cancelled_by")
  isFinalized              Boolean  @default(false) @map("is_finalized")
  approvalStatus           TaskApprovalStatus @default(NOT_SUBMITTED) @map("approval_status")
  approvedStatus           TaskOfficialStatus? @map("approved_status")
  approvedAt               DateTime? @map("approved_at")
  approvedBy               String?  @map("approved_by")
  finalizedAt              DateTime? @map("finalized_at")
  finalizedBy              String?  @map("finalized_by")
  version                  Int      @default(1)
  createdBy                String   @map("created_by")
  updatedBy                String?  @map("updated_by")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  ownerDepartment     Department                 @relation("TaskOwner", fields: [ownerDepartmentId], references: [id])
  creator             User                       @relation("TaskCreator", fields: [createdBy], references: [id])
  updater             User?                      @relation("TaskUpdater", fields: [updatedBy], references: [id])
  coordinatingDepts   TaskCoordinatingDepartment[]
  auditLogs           AuditLog[]
  feedbacks           TaskFeedback[]

  @@index([ownerDepartmentId])
  @@index([requiredCompletionDate])
  @@index([actualCompletionDate])
  @@index([isCancelled])
  @@index([isFinalized])
  @@index([createdAt])
  @@index([ownerDepartmentId, requiredCompletionDate])
  @@map("tasks")
}

model TaskFeedback {
  id         String               @id @default(uuid())
  taskId     String               @map("task_id")
  authorId   String               @map("author_id")
  type       TaskFeedbackType
  decision   TaskFeedbackDecision?
  content    String
  createdAt  DateTime             @default(now()) @map("created_at")

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Restrict)
  readReceipts TaskFeedbackRead[]

  @@index([taskId, createdAt])
  @@map("task_feedbacks")
}

model TaskFeedbackRead {
  feedbackId String   @map("feedback_id")
  userId     String   @map("user_id")
  readAt     DateTime @default(now()) @map("read_at")

  feedback TaskFeedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([feedbackId, userId])
  @@index([userId, readAt])
  @@map("task_feedback_reads")
}

model TaskCoordinatingDepartment {
  taskId       String     @map("task_id")
  departmentId String     @map("department_id")

  task       Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@id([taskId, departmentId])
  @@map("task_coordinating_departments")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  fieldName  String?  @map("field_name")
  oldValue   String?  @map("old_value")
  newValue   String?  @map("new_value")
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])
  task Task? @relation(fields: [entityId], references: [id])

  @@index([userId])
  @@index([entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model PeriodLock {
  id        String   @id @default(uuid())
  year      Int
  month     Int
  lockedAt  DateTime @map("locked_at")
  lockedBy  String   @map("locked_by")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([year, month])
  @@map("period_locks")
}
